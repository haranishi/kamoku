{
  "test_cmd": ["python3", "-m", "unittest", "discover", "-s", "tools/tests", "-v"],
  "timeout_sec": 60,
  "exclude": [
    "target", ".git", "node_modules", ".cargo-home", ".cargo-target", "screens-out",
    "test-results", "playwright-report", "__pycache__"
  ],
  "mutations": [
    {
      "label": "前提: 必要なコマンドが無くても成功扱い",
      "file": "tools/check-all.sh",
      "find": "  printf '  - %s\\n' \"${missing[@]}\" >&2\n  exit 2",
      "replace": "  printf '  - %s\\n' \"${missing[@]}\" >&2\n  exit 0"
    },
    {
      "label": "段階: 不明な名前でも成功扱い",
      "file": "e2e/run-real.sh",
      "find": "  *) echo \"不明な段階: $WHICH\" >&2; usage >&2; exit 2 ;;",
      "replace": "  *) echo \"不明な段階: $WHICH\" >&2; usage >&2; exit 0 ;;"
    },
    {
      "label": "ビルド: Rustのビルド失敗を成功扱い",
      "file": "e2e/run-real.sh",
      "find": "    echo \"Rustのビルドに失敗しました。試験を開始しません。\" >&2\n    exit 1",
      "replace": "    echo \"Rustのビルドに失敗しました。試験を開始しません。\" >&2\n    exit 0"
    },
    {
      "label": "依存: E2Eのビルドでロックファイルを更新できる",
      "file": "e2e/run-real.sh",
      "find": "cargo build -p kamoku-app --bin kamoku --locked --message-format=json-render-diagnostics",
      "replace": "cargo build -p kamoku-app --bin kamoku --message-format=json-render-diagnostics"
    }
  ]
}
